<mujoco model="SCOUT MINI - approximate off-road model">
  <!-- SI units; +X forward, +Y left, +Z up.
       Envelope 0.612 x 0.580 x 0.245 m; unloaded mass 23 kg.
       Primitive geometry, inertia, tire, motor and suspension values are estimates.
       Suspension uses vertical spring-damper travel as a rocker-arm surrogate.
       Source: https://global.agilex.ai/products/scout-mini-off-road-robotics-research
  -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"
          cone="elliptic" iterations="80"/>
  <statistic center="0 0 0.15" extent="2"/>

  <default>
    <geom friction="0.8 0.01 0.001" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="2" mass="0"/>
    </default>
    <default class="suspension">
      <!-- 0.04 m travel; spring preload supports the 16 kg sprung chassis. -->
      <joint type="slide" axis="0 0 1" range="-0.025 0.015"
             stiffness="5000" damping="120" springref="-0.007848" armature="0.01"/>
    </default>
    <default class="wheel">
      <joint type="hinge" axis="0 1 0" damping="0.02" armature="0.015"/>
      <!-- Cylinder Z axis rotated onto the wheel axle (+Y). -->
      <geom type="cylinder" size="0.1 0.045" euler="1.57079632679 0 0"
            material="rubber" condim="4" friction="0.8 0.005 0.0001"/>
    </default>
    <velocity kv="6" ctrllimited="true" ctrlrange="-15 15"
              forcelimited="true" forcerange="-8 8"/>
  </default>

  <custom>
    <numeric name="drive_track" data="0.49"/>
  </custom>
  <asset>
    <texture name="ground_texture" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.22 0.26 0.23" rgb2="0.29 0.33 0.29"/>
    <material name="ground_material" texture="ground_texture" texrepeat="20 20"
              texuniform="true" reflectance="0.05"/>
    <material name="body_paint" rgba="0.18 0.21 0.23 1"/>
    <material name="rubber" rgba="0.045 0.045 0.05 1"/>
    <material name="metal" rgba="0.65 0.68 0.7 1" specular="0.5"/>
    <material name="blue" rgba="0.04 0.4 0.8 1"/>
  </asset>

  <worldbody>
    <light pos="0 -2 4" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="ground" type="plane" size="0 0 0.1" material="ground_material"/>

    <body name="base_link" pos="0 0 0.18">
      <freejoint name="floating_base"/>
      <!-- Chassis 16 + 4 carriers * 0.25 + 4 wheels * 1.5 = 23 kg. -->
      <inertial pos="0 0 0" mass="16" diaginertia="0.20 0.45 0.60"/>
      <geom name="chassis" type="box" size="0.275 0.195 0.065" material="body_paint"/>
      <geom name="front_bumper" type="box" pos="0.290 0 -0.01"
            size="0.016 0.19 0.022" material="rubber"/>
      <geom name="rear_bumper" type="box" pos="-0.290 0 -0.01"
            size="0.016 0.19 0.022" material="rubber"/>
      <geom class="visual" name="top_panel" type="box" pos="0 0 0.060"
            size="0.255 0.18 0.005" material="metal"/>
      <geom class="visual" name="left_rail" type="box" pos="0 0.15 0.061"
            size="0.25 0.012 0.004" material="body_paint"/>
      <geom class="visual" name="right_rail" type="box" pos="0 -0.15 0.061"
            size="0.25 0.012 0.004" material="body_paint"/>
      <geom class="visual" name="front_light" type="box" pos="0.276 0 0.015"
            size="0.001 0.13 0.012" rgba="0.9 0.95 1 1"/>
      <geom class="visual" name="rear_light" type="box" pos="-0.276 0 0.015"
            size="0.001 0.13 0.008" rgba="0.9 0.05 0.03 1"/>
      <site name="imu" pos="0 0 0.04" size="0.008" rgba="0 0.8 0.4 1"/>
      <site name="payload_mount" pos="0 0 0.065" size="0.008" rgba="0.1 0.5 1 1"/>
      <camera name="follow" mode="trackcom" pos="1.4 -1.6 1.1"
              xyaxes="0.7526 0.6585 0 -0.2875 0.3286 0.8997"/>

      <!-- Estimated wheelbase 0.412 m, track 0.490 m, tire radius 0.100 m. -->
      <body name="front_left_carrier" pos="0.206 0.245 -0.08">
        <joint name="front_left_suspension" class="suspension"/>
        <inertial pos="0 0 0" mass="0.25" diaginertia="0.0003 0.0003 0.0003"/>
        <geom class="visual" type="capsule" fromto="0 -0.055 0.035 0 0 0" size="0.012" material="metal"/>
        <body name="front_left_wheel">
          <joint name="front_left_joint" class="wheel"/>
          <geom name="front_left_tire" class="wheel" mass="1.5"/>
          <geom class="visual" type="cylinder" pos="0 0.043 0" size="0.055 0.001" euler="1.57079632679 0 0" material="metal"/>
          <geom class="visual" type="box" pos="0 0.044 0.055" size="0.008 0.001 0.025" material="blue"/>
        </body>
      </body>
      <body name="rear_left_carrier" pos="-0.206 0.245 -0.08">
        <joint name="rear_left_suspension" class="suspension"/>
        <inertial pos="0 0 0" mass="0.25" diaginertia="0.0003 0.0003 0.0003"/>
        <geom class="visual" type="capsule" fromto="0 -0.055 0.035 0 0 0" size="0.012" material="metal"/>
        <body name="rear_left_wheel">
          <joint name="rear_left_joint" class="wheel"/>
          <geom name="rear_left_tire" class="wheel" mass="1.5"/>
          <geom class="visual" type="cylinder" pos="0 0.043 0" size="0.055 0.001" euler="1.57079632679 0 0" material="metal"/>
          <geom class="visual" type="box" pos="0 0.044 0.055" size="0.008 0.001 0.025" material="blue"/>
        </body>
      </body>
      <body name="front_right_carrier" pos="0.206 -0.245 -0.08">
        <joint name="front_right_suspension" class="suspension"/>
        <inertial pos="0 0 0" mass="0.25" diaginertia="0.0003 0.0003 0.0003"/>
        <geom class="visual" type="capsule" fromto="0 0.055 0.035 0 0 0" size="0.012" material="metal"/>
        <body name="front_right_wheel">
          <joint name="front_right_joint" class="wheel"/>
          <geom name="front_right_tire" class="wheel" mass="1.5"/>
          <geom class="visual" type="cylinder" pos="0 -0.043 0" size="0.055 0.001" euler="1.57079632679 0 0" material="metal"/>
          <geom class="visual" type="box" pos="0 -0.044 0.055" size="0.008 0.001 0.025" material="blue"/>
        </body>
      </body>
      <body name="rear_right_carrier" pos="-0.206 -0.245 -0.08">
        <joint name="rear_right_suspension" class="suspension"/>
        <inertial pos="0 0 0" mass="0.25" diaginertia="0.0003 0.0003 0.0003"/>
        <geom class="visual" type="capsule" fromto="0 0.055 0.035 0 0 0" size="0.012" material="metal"/>
        <body name="rear_right_wheel">
          <joint name="rear_right_joint" class="wheel"/>
          <geom name="rear_right_tire" class="wheel" mass="1.5"/>
          <geom class="visual" type="cylinder" pos="0 -0.043 0" size="0.055 0.001" euler="1.57079632679 0 0" material="metal"/>
          <geom class="visual" type="box" pos="0 -0.044 0.055" size="0.008 0.001 0.025" material="blue"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- ctrl is wheel angular velocity in rad/s, positive drives forward. -->
    <velocity name="front_left_motor" joint="front_left_joint"/>
    <velocity name="rear_left_motor" joint="rear_left_joint"/>
    <velocity name="front_right_motor" joint="front_right_joint"/>
    <velocity name="rear_right_motor" joint="rear_right_joint"/>
  </actuator>
  <sensor>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_acceleration" site="imu"/>
    <framequat name="base_orientation" objtype="body" objname="base_link"/>
    <jointvel name="front_left_encoder" joint="front_left_joint"/>
    <jointvel name="rear_left_encoder" joint="rear_left_joint"/>
    <jointvel name="front_right_encoder" joint="front_right_joint"/>
    <jointvel name="rear_right_encoder" joint="rear_right_joint"/>
  </sensor>
</mujoco>
